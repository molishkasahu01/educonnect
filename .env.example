# ==============================================================================
# EduConnect — School Influencer Intelligence
# Environment Configuration Template (NEVER commit real secrets to git)
# ==============================================================================

# --- Application ---
APP_NAME="EduConnect School Influencer Intelligence"
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api

# --- Security & JWT Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-at-least-48-random-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010

# --- Database (Production: PostgreSQL + pgvector) ---
# Production example: postgresql+psycopg2://edxso:edxso_password@postgres:5432/edxso
# Local fallback (when Postgres is unavailable): sqlite:///./edxso_local.db
DATABASE_URL=postgresql+psycopg2://edxso:edxso_password@localhost:5432/edxso

# --- Redis & Celery Queue ---
# Production/Docker uses Celery + Redis; local dev can set TASK_QUEUE_MODE=local
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
TASK_QUEUE_MODE=celery

# --- AI / ML Models ---
# Recommended production model: BAAI/bge-m3 (1024-dim, ~2.3GB weights)
# Lightweight CPU/low-RAM compatible model: BAAI/bge-small-en-v1.5 (384-dim, ~133MB weights)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional External LLM Enrichment (deterministic fallback works without keys) ---
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional Authorized Licensed Data Adapters (used in REAL_DATA discovery mode) ---
# When unset, REAL_DATA discovery completes honestly with 0 live licensed API profiles
# and never falls back to synthetic benchmark records. Never configure restricted domains.
LICENSED_DATA_API_URL=
LICENSED_DATA_API_KEY=

# --- File Upload Limits & Data Retention ---
MAX_UPLOAD_SIZE_MB=10
DATA_RETENTION_DAYS=365

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
